{
  "name": "database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "pnpm run studio",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json",
    "push-dev": "drizzle-kit push",
    "generate-migration": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate --config drizzle.remote.config.ts",
    "studio": "drizzle-kit studio",
    "export-postgres": "bun scripts/export-postgres-to-d1.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "luxon": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "@types/luxon": "catalog:",
    "drizzle-kit": "beta",
    "typescript": "catalog:"
  }
}
