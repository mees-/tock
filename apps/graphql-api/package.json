{
  "name": "graphql-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev --port 4000 --var NODE_ENV:development",
    "dev:cron": "bun scripts/dev-cron.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json",
    "generate-schema": "bun --preload ./scripts/cloudflare-workers-stub.ts src/generate-schema.ts",
    "dev:generate-schema-watch": "bun --watch --preload ./scripts/cloudflare-workers-stub.ts src/generate-schema.ts"
  },
  "dependencies": {
    "@pothos/core": "^4.3.0",
    "@pothos/plugin-with-input": "^4.1.4",
    "auth": "workspace:*",
    "croner": "catalog:",
    "database": "workspace:*",
    "drizzle-orm": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "^5.10.3",
    "hono": "^4.12.3",
    "luxon": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "^25.4.0",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
