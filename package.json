{
  "name": "tock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run setup-db && vite",
    "setup-db": "wrangler d1 execute DB --local --command 'SELECT 1' && drizzle-kit push",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate-migration": "drizzle-kit generate",
    "db:migrate-remote": "drizzle-kit migrate --config drizzle.remote.config.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "deploy": "BASE_URL=https://tock.run/ pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.2.2",
    "@noble/hashes": "^2.4.0",
    "@posthog/react": "^1.8.2",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-virtual": "^3.13.23",
    "clsx": "^2.1.1",
    "croner": "^10.0.1",
    "cronstrue": "^3.13.0",
    "drizzle-orm": "beta",
    "hono": "^4.12.3",
    "http-headers-validation": "^0.0.2",
    "jose": "^6.1.3",
    "lucide-react": "^0.575.0",
    "luxon": "^3.7.2",
    "posthog-js": "^1.360.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-hotkeys-hook": "^5.2.4",
    "stripe": "^20.4.0",
    "usehooks-ts": "^3.1.1",
    "wouter": "^3.9.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "^1.3.8",
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "drizzle-kit": "beta",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-sitemap": "^0.8.2",
    "wrangler": "^4.156.0"
  }
}
